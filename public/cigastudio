        }

        .feature-grid {

            display: grid;

            grid-template-columns:
                1fr
                1fr;

            gap: 14px;

            margin-top: 20px;
        }

        .feature {

            padding:
                18px;

            border:
                1px solid
                #333;

            background: #050505;
        }

        .feature-title {

            color: #fff;

            font-size: 12px;

            font-weight: bold;

            letter-spacing: 2px;

            margin-bottom: 10px;
        }

        .feature-text {

            color: #fff;

            font-size: 14px;

            line-height: 1.8;
        }

        .command {

            display: inline-block;

            padding:
                2px 8px;

            border:
